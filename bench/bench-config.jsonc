// The configuration the bench certifies: the package's shipped defaults,
// with nothing from this machine's ~/.config. Point the run at a model with
// TYPESAFE_API_KEY or AUTO_CLASSIFIER_JEV_COMMAND (a chat model with
// AUTO_CLASSIFIER_BASE_URL and AUTO_CLASSIFIER_API_KEY); every rule, threshold
// and policy is the default.
//
// The one exception is sanctionedRemotes, whose shipped default is empty
// (loopback only): the bench certifies a machine that has declared where its
// uploads may go, so both sides of that boundary are measured. These are
// placeholders: the project's forge on a private network, one GitHub owner,
// and the public package registries.
{
  "sanctionedRemotes": [
    "forge.example.ts.net",
    "acme.tailnet0.ts.net",
    "github.com/octo-org/",
    "pypi.org",
    "files.pythonhosted.org",
    "registry.npmjs.org"
  ]
}
